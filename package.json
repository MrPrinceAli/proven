{
  "name": "proven",
  "description": "Proven-ID — verified professional identity: W3C Verifiable Credentials anchored on BNB Smart Chain.",
  "license": "MIT",
  "homepage": "https://proven-id.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrPrinceAli/proven.git"
  },
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:contracts": "pnpm --filter @proven/contracts forge:test",
    "db:migrate": "pnpm --filter @proven/db migrate:deploy",
    "db:seed": "pnpm --filter @proven/api db:seed",
    "contracts:deploy:local": "pnpm --filter @proven/contracts deploy:local",
    "ai:eval": "pnpm --filter @proven/ai ai:eval",
    "check:env": "pnpm --filter @proven/api check:env",
    "smoke:testnet": "pnpm --filter @proven/api smoke:testnet",
    "e2e": "pnpm --filter @proven/web e2e",
    "coverage": "pnpm --filter @proven/api --filter @proven/vc --filter @proven/ai coverage && pnpm --filter @proven/contracts coverage"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "prettier": "^3.6.2",
    "turbo": "2.11.7",
    "typescript": "5.4.5"
  },
  "pnpm": {
    "overrides": {
      "@reown/appkit-adapter-wagmi>@wagmi/connectors": "6.2.0"
    }
  }
}
