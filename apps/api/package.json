{
  "name": "@proven/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src test scripts --ext .ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "issuer:register": "tsx scripts/register-issuer.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "check:env": "tsx scripts/check-env.ts",
    "smoke:testnet": "tsx scripts/smoke-testnet.ts",
    "coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='**/*.test.ts' --coverage.reporter=text-summary --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/helmet": "11.1.1",
    "@fastify/multipart": "8.3.1",
    "@fastify/rate-limit": "9.1.0",
    "@proven/ai": "workspace:^",
    "@proven/contracts": "workspace:^",
    "@proven/db": "workspace:^",
    "@proven/vc": "workspace:^",
    "fastify": "4.29.1",
    "fastify-plugin": "4.5.1",
    "pdf-lib": "1.17.1",
    "viem": "2.57.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "tsx": "^4.20.0",
    "typescript": "5.4.5",
    "vitest": "^3.2.4"
  }
}
