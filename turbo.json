{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", ".eslintrc.cjs"],
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV",
    "DATABASE_URL",
    "DATABASE_URL_UNPOOLED",
    "DATABASE_URL_TEST",
    "RPC_URL",
    "CHAIN_ID",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_BRANCH_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "REQUIRE_ANVIL",
    "ANVIL_RPC_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false
    },
    "@proven/api#test": {
      "dependsOn": ["@proven/db#test"],
      "cache": false
    }
  }
}
